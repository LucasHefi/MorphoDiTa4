{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MorphoDiTa Client",
  "version": "0.1.21",
  "identifier": "cz.ufal.morphodita",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MorphoDiTa Client",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https://lindat.mff.cuni.cz; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/morphodita-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE",
      "../../licenses/MPL-2.0.txt": "licenses/MPL-2.0.txt",
      "../../third_party/morphodita/rest_server.cpp": "third_party/morphodita/rest_server.cpp",
      "../../third_party/morphodita/loopback.patch": "third_party/morphodita/loopback.patch",
      "../../third_party/morphodita/README.md": "third_party/morphodita/README.md"
    },
    "windows": {
      "nsis": {
        "template": null,
        "languages": [
          "English",
          "Czech",
          "Polish"
        ]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
