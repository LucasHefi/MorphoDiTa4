{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/models" },
        { "path": "$APPDATA/models/**/*" }
      ]
    },
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-open",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-exists",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/morphodita-server",
          "sidecar": true,
          "args": [
            { "validator": "^876[5-9]$" },
            "czech-250909",
            { "validator": "^(?:/(?:[A-Za-z0-9 _-][A-Za-z0-9._ -]*/)*models/czech-250909/czech\\.tagger|[A-Za-z]:\\\\(?:[A-Za-z0-9 _-][A-Za-z0-9._ -]*\\\\)*models\\\\czech-250909\\\\czech\\.tagger)$" },
            "https://hdl.handle.net/11234/1-5985"
          ]
        }
      ]
    },
    "shell:allow-kill"
  ]
}
