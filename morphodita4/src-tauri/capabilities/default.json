{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA/models"
        },
        {
          "path": "$APPDATA/models/**/*"
        }
      ]
    },
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-fstat",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-exists",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/morphodita-server",
          "sidecar": true,
          "args": [
            "--log_file=",
            {
              "validator": "^876[5-9]$"
            },
            "czech-250909",
            {
              "validator": "^(?:/(?:(?:[\\p{L}\\p{M}\\p{N} _-][\\p{L}\\p{M}\\p{N}._ -]*|\\.[\\p{L}\\p{M}\\p{N}_-][\\p{L}\\p{M}\\p{N}._ -]*)/)*models/czech-250909/czech\\.tagger|[A-Za-z]:\\\\(?:(?:[\\p{L}\\p{M}\\p{N} _-][\\p{L}\\p{M}\\p{N}._ -]*|\\.[\\p{L}\\p{M}\\p{N}_-][\\p{L}\\p{M}\\p{N}._ -]*)\\\\)*models\\\\czech-250909\\\\czech\\.tagger)$"
            },
            "https://hdl.handle.net/11234/1-5985",
            "czech-250909-no_dia",
            {
              "validator": "^(?:/(?:(?:[\\p{L}\\p{M}\\p{N} _-][\\p{L}\\p{M}\\p{N}._ -]*|\\.[\\p{L}\\p{M}\\p{N}_-][\\p{L}\\p{M}\\p{N}._ -]*)/)*models/czech-250909-no_dia/czech\\.tagger|[A-Za-z]:\\\\(?:(?:[\\p{L}\\p{M}\\p{N} _-][\\p{L}\\p{M}\\p{N}._ -]*|\\.[\\p{L}\\p{M}\\p{N}_-][\\p{L}\\p{M}\\p{N}._ -]*)\\\\)*models\\\\czech-250909-no_dia\\\\czech\\.tagger)$"
            },
            "https://hdl.handle.net/11234/1-5985"
          ]
        }
      ]
    },
    "shell:allow-kill"
  ]
}
